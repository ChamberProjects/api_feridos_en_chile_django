@model IEnumerable<FeriadosChileNet5.Models.Feriado>

@{
    ViewData["Title"] = "Feriados de Chile";
}

<div class="container mt-4">
    <h1>Feriados de Chile</h1>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <table class="table table-striped table-bordered mt-3">
        <thead>
            <tr>
                <th>Día</th>
                <th>Título</th>
                <th>Estado</th>
                <th>True/False</th>
                <th>Irrefrenunciable / Extra</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var feriado in Model)
        {
            <tr>
                <td>@feriado.Date.ToString("dd-MM-yyyy")</td>
                <td>@feriado.Title</td>
                <td>@feriado.Type</td>
                <td>@feriado.Inalienable</td>
                <td>@feriado.Extra</td>
            </tr>
        }
        </tbody>
    </table>
</div>
